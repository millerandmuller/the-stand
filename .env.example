# Get an API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=PASTE_YOUR_ACTUAL_API_KEY_HERE

# GCP project for Firestore session persistence (F8). Only needed if you
# want session persistence locally too — the deployed Cloud Run service sets
# this automatically. Leave unset to fall back to the ADC-detected project.
GOOGLE_CLOUD_PROJECT=the-stand-2026
